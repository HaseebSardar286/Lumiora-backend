# ─────────────────────────────────────────────────────────────
# 8BitField Backend – Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Server port (local only – Vercel ignores this)
PORT=5000

# MongoDB Atlas connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"

# Admin login credentials — used ONLY to create the first admin if the collection is empty.
# After that, login reads from MongoDB. Update password in the DB (or delete the admin
# row and restart to re-seed from these env vars). No surrounding quotes in Vercel.
ADMIN_EMAIL=admin@8bitfield.com
ADMIN_PASSWORD=your-secure-password

# CORS – the deployed frontend URL (no trailing slash)
# Local dev: set to http://localhost:3000 or leave unset (localhost is always allowed)
# Production: https://lumiora-two.vercel.app
FRONTEND_URL=https://lumiora-two.vercel.app

# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use a Gmail App Password (not your regular password)
SMTP_PASS=your-app-password
EMAIL_FROM="8BitField Consultations <your-email@gmail.com>"
